  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/LRM_IDARTES_SEC_RECIE%CC%81N_OI%CC%81DOS-ORQUESTA_FILARMO%CC%81NICA_JUVENIL_BOGOTA%CC%81_TEATROELPARQUE_LZK_3656_07062026.jpg?itok=73cXp4qe"/>
