  <updated>2026-12-05T19:00:00-05:00</updated>
  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/IMG_9852-%281%29.JPG.jpeg?itok=6uSojqx8"/>
