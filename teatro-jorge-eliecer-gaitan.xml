  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/web_1.jpg?itok=qwfR80lg"/>
  <media:content url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/web_1.jpg?itok=qwfR80lg" medium="image" type="image/jpeg"/>
