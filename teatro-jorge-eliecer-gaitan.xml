  <published>2026-11-27T19:00:00-05:00</published>
  <updated>2026-11-27T19:00:00-05:00</updated>
  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/noche-oscura.jpg?itok=TAdjWXAV"/>
  <media:content url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/noche-oscura.jpg?itok=TAdjWXAV" medium="image" type="image/jpeg"/>
  <media:thumbnail url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/noche-oscura.jpg?itok=TAdjWXAV"/>
