  <title>Culturas en Común lleva la música coral navideña a la localidad de Rafael Uribe Uribe [Presentación]</title>
  <link href="https://www.idartes.gov.co/es/agenda/presentacion/culturas-en-comun-lleva-la-musica-coral-navidena-la-localidad-de-rafael-uribe"/>
  <id>https://www.idartes.gov.co/es/agenda/presentacion/culturas-en-comun-lleva-la-musica-coral-navidena-la-localidad-de-rafael-uribe</id>
  <published>2026-12-19T19:00:00-05:00</published>
  <updated>2026-12-19T19:00:00-05:00</updated>
  <link rel="enclosure" type="image/png" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/Foto-6.png?itok=FYVb97Xa"/>
  <media:content url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/Foto-6.png?itok=FYVb97Xa" medium="image" type="image/png"/>
  <media:thumbnail url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/Foto-6.png?itok=FYVb97Xa"/>
