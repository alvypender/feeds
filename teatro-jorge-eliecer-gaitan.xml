  <updated>2026-11-07T19:00:00-05:00</updated>
  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/valeriano-noticia_0.jpg?itok=zmm-PzY8"/>
