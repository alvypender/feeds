  <link rel="enclosure" type="image/jpeg" href="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/ishtana.jpg?itok=eyExJCjs"/>
  <media:content url="https://www.idartes.gov.co/sites/default/files/styles/900_x_530/public/imagenes-eventos/ishtana.jpg?itok=eyExJCjs" medium="image" type="image/jpeg"/>
